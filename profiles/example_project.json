{
  "project_identity": "ExampleProject",
  "github": {
    "repository": "example-org/example-repo",
    "canonical_branch": "main"
  },
  "linear": {
    "team_key": "EX",
    "project_id": "example-id"
  },
  "local_builder": {
    "relative_path": "./example-repo",
    "required_env_vars": []
  },
  "validation": {
    "ci_command": "pytest",
    "test_command": "pytest tests/"
  },
  "reviewer_relay": {
    "binding_type": "chatgpt-neutral-relay",
    "contact_uri": "relay://neutral/chatgpt"
  },
  "governance": {
    "capabilities": ["independent_review", "status_report"],
    "required_gates": ["WAITING_PO_AUTH", "CHANGES_REQUESTED"],
    "protected_project": false,
    "cross_project_allowed": false
  }
}
